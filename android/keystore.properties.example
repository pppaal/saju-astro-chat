# Copy this file to android/keystore.properties (gitignored) and fill in
# real values. Never commit the copy or the .jks/.keystore file itself.
#
# Generate a release keystore once (keep it and these passwords forever —
# Google Play requires the SAME signing key for every future update):
#   keytool -genkey -v -keystore destinypal-release.keystore \
#     -alias destinypal -keyalg RSA -keysize 2048 -validity 10000
#
# Since Android App Bundle + Play App Signing (recommended), you upload this
# keystore to Play Console once as your "upload key" and Google re-signs the
# bundle with its own app signing key — see docs/PLAY_STORE_SUBMISSION.md.

storeFile=/absolute/path/to/destinypal-release.keystore
storePassword=changeme
keyAlias=destinypal
keyPassword=changeme
